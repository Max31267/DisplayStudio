<Window x:Class="MiniDisplay.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MiniDisplay.Windows"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Display Studio" Icon="Assets/App.ico" Width="1460" Height="940" MinWidth="1180" MinHeight="780"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize"
        Background="{StaticResource WindowBg}" Foreground="{StaticResource Text}" FontFamily="Segoe UI" FontSize="13"
        UseLayoutRounding="True" SnapsToDevicePixels="True" Closing="WindowClosing" KeyDown="WindowKeyDown">
  <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="64" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="12" UseAeroCaptionButtons="False" /></shell:WindowChrome.WindowChrome>
  <Border Background="White" BorderBrush="{StaticResource Stroke}" BorderThickness="1" CornerRadius="11">
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="64" /><RowDefinition Height="58" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="26" /></Grid.RowDefinitions>
      <Border BorderBrush="{StaticResource Stroke}" BorderThickness="0,0,0,1" Padding="16,0,10,0">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="205" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Border Width="32" Height="32" CornerRadius="7" Background="{StaticResource Accent}" Margin="0,0,10,0"><TextBlock Text="▦" FontSize="26" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><TextBlock Text="Display Studio" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" /></StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" shell:WindowChrome.IsHitTestVisibleInChrome="True">
            <Button Content="Открыть" Click="OpenProject" ToolTip="Открыть проект · Ctrl+O" BorderThickness="0" />
            <Button x:Name="UndoButton" Style="{StaticResource IconButton}" Content="↶" Click="UndoEdit" ToolTip="Отменить · Ctrl+Z" IsEnabled="False" Margin="12,0,4,0" />
            <Button x:Name="RedoButton" Style="{StaticResource IconButton}" Content="↷" Click="RedoEdit" ToolTip="Повторить · Ctrl+Y" IsEnabled="False" Margin="0,0,16,0" />
            <Button Content="Сохранить" Click="SaveProject" Style="{StaticResource PrimaryButton}" Padding="18,9" ToolTip="Сохранить проект · Ctrl+S" />
            <Button Content="⋯" Click="OpenProjectMenu" Style="{StaticResource IconButton}" ToolTip="Сохранить как / выход" Margin="6,0,0,0"><Button.ContextMenu><ContextMenu x:Name="ProjectMenu"><MenuItem Header="Сохранить как…    Ctrl+Shift+S" Click="SaveProjectAs" /><Separator /><MenuItem Header="Убрать неиспользуемые ресурсы" Click="CleanResources" /><Separator /><MenuItem Header="Выход из приложения" Click="ExitApp" /></ContextMenu></Button.ContextMenu></Button>
          </StackPanel>
          <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="14,0"><TextBlock x:Name="ProjectNameLabel" Text="Новый проект" Foreground="{StaticResource Muted}" FontSize="12" TextTrimming="CharacterEllipsis" MaxWidth="220" /><TextBlock x:Name="DirtyMark" Text="●" Foreground="{StaticResource Accent}" FontSize="8" Margin="7,0,0,0" VerticalAlignment="Center" Visibility="Collapsed" /></StackPanel>
          <Button Grid.Column="3" Click="NavigateWorkspace" Tag="2" BorderThickness="0" Margin="8,0,14,0" shell:WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Открыть подключение и эмулятор"><StackPanel Orientation="Horizontal"><Ellipse x:Name="ConnectionIndicator" Width="7" Height="7" Fill="#A6B2C5" Margin="0,0,9,0" /><TextBlock x:Name="ConnectionSummary" Text="Устройство не подключено" FontSize="11" Foreground="{StaticResource Muted}" MaxWidth="220" TextTrimming="CharacterEllipsis" /></StackPanel></Button>
          <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center" shell:WindowChrome.IsHitTestVisibleInChrome="True"><Button Style="{StaticResource IconButton}" Content="−" Click="MinimizeWindow" ToolTip="Свернуть" Width="28" /><Button Style="{StaticResource IconButton}" Content="□" Click="MaximizeWindow" ToolTip="Развернуть / восстановить" Width="28" /><Button Style="{StaticResource IconButton}" Content="×" Click="HideWindow" ToolTip="Свернуть в трей" Width="28" /></StackPanel>
        </Grid>
      </Border>
      <Border Grid.Row="1" BorderBrush="{StaticResource Stroke}" BorderThickness="0,0,0,1">
        <Grid><StackPanel Orientation="Horizontal" Margin="14,0,0,0">
          <RadioButton x:Name="PlaybackNavigation" Content="Показ" GroupName="Workspace" Tag="0" Click="NavigateWorkspace" Style="{StaticResource WorkspaceNavigation}" />
          <RadioButton x:Name="EditorNavigation" Content="Редактор" GroupName="Workspace" Tag="1" IsChecked="True" Click="NavigateWorkspace" Style="{StaticResource WorkspaceNavigation}" />
          <RadioButton x:Name="SourcesNavigation" Content="Данные" GroupName="Workspace" Tag="3" Click="NavigateWorkspace" Style="{StaticResource WorkspaceNavigation}" /><RadioButton x:Name="DeviceNavigation" Content="Устройство" GroupName="Workspace" Tag="2" Click="NavigateWorkspace" Style="{StaticResource WorkspaceNavigation}" /><RadioButton x:Name="SettingsNavigation" Content="Настройки" GroupName="Workspace" Tag="4" Click="NavigateWorkspace" Style="{StaticResource WorkspaceNavigation}" />
        </StackPanel><TextBlock x:Name="WorkspaceHint" Text="Соберите содержимое каждой страницы" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,26,0" Foreground="{StaticResource Muted}" FontSize="12" /></Grid>
      </Border>
      <Border Grid.Row="2" Background="#FFF1F3" Padding="20,9"><Border.Style><Style TargetType="Border"><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=ValidationStatus}" Value=""><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></Border.Style><TextBlock x:Name="ValidationStatus" Foreground="{StaticResource Danger}" TextWrapping="Wrap" /></Border>
      <Grid Grid.Row="3">
        <Grid.ColumnDefinitions><ColumnDefinition x:Name="PageSidebarColumn" Width="260" /><ColumnDefinition Width="*" /><ColumnDefinition x:Name="InspectorColumn" Width="326" /></Grid.ColumnDefinitions>
        <Border x:Name="PageSidebar" Background="White" BorderBrush="{StaticResource Stroke}" BorderThickness="0,0,1,0">
          <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition x:Name="PagesRow" Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition x:Name="ElementsRow" Height="*" /></Grid.RowDefinitions>
            <StackPanel Margin="16,18,16,12">
              <Grid><TextBlock x:Name="PagesHeading" Text="Страницы" FontSize="17" FontWeight="SemiBold" /><TextBlock x:Name="PageCountLabel" Foreground="{StaticResource Muted}" HorizontalAlignment="Right" VerticalAlignment="Center" /></Grid>
              <Button Content="+ Добавить страницу" Click="OpenPageMenu" Margin="0,12,0,0" HorizontalContentAlignment="Left"><Button.ContextMenu><ContextMenu x:Name="PageMenu"><MenuItem Header="Часы и погода" Tag="4" Click="QuickAddPage" /><MenuItem Header="Компьютер" Tag="5" Click="QuickAddPage" /><MenuItem Header="Музыка" Tag="6" Click="QuickAddPage" /><MenuItem Header="Лимиты Codex" Tag="7" Click="QuickAddPage" /><Separator /><MenuItem Header="Пустая страница" Tag="3" Click="QuickAddPage" /><MenuItem Header="Страница с часами" Tag="0" Click="QuickAddPage" /><MenuItem Header="Страница с текстом" Tag="1" Click="QuickAddPage" /><Separator /><MenuItem Header="Проверка цветов дисплея" Tag="2" Click="QuickAddPage" /></ContextMenu></Button.ContextMenu></Button>
            </StackPanel>
            <ListBox x:Name="PagesList" Grid.Row="1" Margin="10,0" SelectionChanged="PageSelected" AllowDrop="True" PreviewMouseLeftButtonDown="ReorderDown" PreviewMouseLeftButtonUp="PageClicked" PreviewMouseMove="ReorderMove" DragOver="ReorderOver" Drop="PagesDropped" ScrollViewer.VerticalScrollBarVisibility="Auto">
              <ListBox.ItemTemplate><DataTemplate><Grid Opacity="{Binding Opacity}"><Grid.ColumnDefinitions><ColumnDefinition Width="58" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Border Background="#EEF2F8" CornerRadius="4" Width="52" Height="52"><Image Source="{Binding Thumbnail}" Width="48" Height="48" RenderOptions.BitmapScalingMode="HighQuality" /></Border><StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding Summary}" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,5,0,0" /><TextBlock Text="Сейчас в показе" Foreground="{StaticResource Accent}" FontSize="10" Margin="0,4,0,0"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding IsOnAir}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></StackPanel></Grid></DataTemplate></ListBox.ItemTemplate>
            </ListBox>
            <StackPanel Grid.Row="2" Margin="16,8,16,12"><StackPanel Orientation="Horizontal"><Button Content="↑" Click="MovePageUp" ToolTip="Страница раньше в показе" Padding="9,5" /><Button Content="↓" Click="MovePageDown" ToolTip="Страница позже в показе" Padding="9,5" Margin="5,0" /><Button Content="Копия" Click="DuplicatePage" Padding="9,5" Margin="0,0,5,0" /><Button Content="Удалить" Click="DeletePage" Padding="9,5" /></StackPanel><TextBlock Text="Перетаскивайте страницы для смены порядка" TextWrapping="Wrap" FontSize="10" Foreground="{StaticResource Muted}" Margin="0,9,0,0" /></StackPanel>
            <Border x:Name="ElementsPanel" Grid.Row="3" BorderBrush="{StaticResource Stroke}" BorderThickness="0,1,0,0">
              <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <StackPanel Margin="16,16,16,10"><Grid><TextBlock Text="Элементы страницы" FontWeight="SemiBold" FontSize="14" /><TextBlock x:Name="LayerCountLabel" Foreground="{StaticResource Muted}" HorizontalAlignment="Right" /></Grid><TextBlock Text="{Binding Text, ElementName=PageNameInput}" Foreground="{StaticResource Muted}" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,5,0,0" /></StackPanel>
                <ListBox x:Name="LayersList" Grid.Row="1" Margin="10,0" SelectionChanged="LayerSelected" AllowDrop="True" PreviewMouseLeftButtonDown="ReorderDown" PreviewMouseMove="ReorderMove" DragOver="ReorderOver" Drop="LayersDropped">
                  <ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="24" /><ColumnDefinition Width="*" /><ColumnDefinition Width="26" /></Grid.ColumnDefinitions><TextBlock Text="{Binding Glyph}" Foreground="#52627C" FontSize="16" VerticalAlignment="Center" /><TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="6,0" /><Button Grid.Column="2" Style="{StaticResource IconButton}" Width="24" Content="◉" Tag="{Binding Id}" Click="ToggleLayerVisibility" ToolTip="Показать или скрыть элемент" Opacity="{Binding Opacity}" /></Grid></DataTemplate></ListBox.ItemTemplate>
                </ListBox>
                <StackPanel Grid.Row="2" Margin="16,8,16,12"><StackPanel Orientation="Horizontal"><Button Content="↑" Click="MoveLayerUp" Padding="9,5" ToolTip="Элемент на задний план" /><Button Content="↓" Click="MoveLayerDown" Padding="9,5" Margin="5,0" ToolTip="Элемент на передний план" /><Button Content="Копия" Click="DuplicateLayer" Padding="9,5" Margin="0,0,5,0" /><Button Content="Удалить" Click="DeleteLayer" Padding="9,5" /></StackPanel></StackPanel>
              </Grid>
            </Border>
          </Grid>
        </Border>
        <Grid x:Name="WorkspaceHost" Grid.Column="1" Background="{StaticResource WindowBg}">
          <local:SectionHost x:Name="WorkspaceTabs" SelectedIndex="1" SelectionChanged="WorkspaceChanged">
            <Grid>
              <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <Border Background="White" Padding="24,20" BorderBrush="{StaticResource Stroke}" BorderThickness="0,0,0,1"><StackPanel><TextBlock Text="Показ страниц" FontSize="20" FontWeight="SemiBold" /><TextBlock Text="Выберите страницу слева или включите автоматическую смену." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,7,0,16" /><CheckBox x:Name="RotateCheck" Content="Автоматически менять страницы" IsChecked="True" Checked="RotationChanged" Unchecked="RotationChanged" VerticalAlignment="Center" /></StackPanel></Border>
                <Grid Grid.Row="1" Margin="28"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions><StackPanel HorizontalAlignment="Center" Margin="0,0,0,18"><TextBlock Text="Сейчас показывается" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" FontSize="12" /><TextBlock x:Name="PageTitle" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,5,0,0" /></StackPanel><Viewbox Grid.Row="1" MaxWidth="420" MaxHeight="420" HorizontalAlignment="Center" VerticalAlignment="Center"><Border Background="White" Padding="10" CornerRadius="10"><Image x:Name="Preview" Width="240" Height="240" RenderOptions.BitmapScalingMode="HighQuality" /></Border></Viewbox><TextBlock x:Name="PlaybackStatus" Grid.Row="2" HorizontalAlignment="Center" Foreground="{StaticResource Muted}" Margin="0,18,0,0" /></Grid>
                <TextBlock Grid.Row="2" Text="Нажмите страницу слева, чтобы сразу показать её." Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="24,0,24,22" />
              </Grid>
            </Grid>
            <Grid>
              <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <Border Background="White" BorderBrush="{StaticResource Stroke}" BorderThickness="0,0,0,1" Padding="18,14"><WrapPanel>
                  <Button Content="+ Добавить элемент" Click="OpenLayerMenu" Style="{StaticResource PrimaryButton}" Margin="0,0,10,4"><Button.ContextMenu><ContextMenu x:Name="LayerMenu"><MenuItem Header="Картинка или GIF…" Click="ImportMedia" /><Separator /><MenuItem Header="Значение из источника" Tag="DataText" Click="QuickAddLayer" /><MenuItem Header="Шкала значения" Tag="Bar" Click="QuickAddLayer" /><MenuItem Header="Кольцевой индикатор" Tag="Ring" Click="QuickAddLayer" /><MenuItem Header="График за минуту" Tag="Graph" Click="QuickAddLayer" /><MenuItem Header="Обложка музыки" Tag="Artwork" Click="QuickAddLayer" /><MenuItem Header="Погодная иконка" Tag="WeatherIcon" Click="QuickAddLayer" /><Separator /><MenuItem Header="Текст — своя надпись" Tag="Text" Click="QuickAddLayer" /><Separator /><MenuItem Header="Часы — текущее время" Tag="Clock" Click="QuickAddLayer" /><MenuItem Header="Секунды" Tag="Seconds" Click="QuickAddLayer" /><MenuItem Header="Дата" Tag="Date" Click="QuickAddLayer" /><MenuItem Header="День недели" Tag="Weekday" Click="QuickAddLayer" /><Separator /><MenuItem Header="Шкала секунд" Tag="SecondsBar" Click="QuickAddLayer" /><MenuItem Header="Тест цветов" Tag="Calibration" Click="QuickAddLayer" /></ContextMenu></Button.ContextMenu></Button>
                  <Button Content="Проверить показ →" Tag="0" Click="NavigateWorkspace" Margin="0,0,0,4" />
                </WrapPanel></Border>
                <ScrollViewer x:Name="EditorScroll" Grid.Row="1" Background="{StaticResource CanvasPattern}" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" CanContentScroll="False"><Grid MinWidth="{Binding ViewportWidth, ElementName=EditorScroll}" MinHeight="{Binding ViewportHeight, ElementName=EditorScroll}"><Viewbox x:Name="EditorViewbox" Width="480" Height="480" Margin="24" HorizontalAlignment="Center" VerticalAlignment="Center"><Border><Border.Effect><DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.16" Color="#536580" /></Border.Effect><Image x:Name="EditorPreview" Width="240" Height="240" RenderOptions.BitmapScalingMode="HighQuality" Cursor="Arrow" Focusable="True" MouseLeftButtonDown="CanvasDown" MouseMove="CanvasMove" MouseLeftButtonUp="CanvasUp" LostMouseCapture="CanvasLostCapture" /></Border></Viewbox></Grid></ScrollViewer>
                <Border Grid.Row="2" Background="White" Padding="16,10" BorderBrush="{StaticResource Stroke}" BorderThickness="0,1,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock x:Name="EditingPageTitle" FontWeight="SemiBold" FontSize="12" /><TextBlock Text="Выберите элемент на холсте или в списке слева" Foreground="{StaticResource Muted}" FontSize="10" Margin="0,4,0,0" /></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><CheckBox x:Name="GridCheck" Content="Сетка" ToolTip="Сетка 16 × 16" Margin="0,0,14,0" /><Button Style="{StaticResource IconButton}" Content="−" Click="ZoomOut" ToolTip="Уменьшить холст" Width="25" /><TextBlock x:Name="ZoomLabel" Text="100%" MinWidth="40" TextAlignment="Center" VerticalAlignment="Center" FontSize="11" /><Button Style="{StaticResource IconButton}" Content="+" Click="ZoomIn" ToolTip="Увеличить холст" Width="25" /><Button Content="Вписать" Click="FitCanvas" FontSize="11" Padding="8,5" Margin="8,0,0,0" /></StackPanel></Grid></Border>
              </Grid>
            </Grid>
            <Grid>
              <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel MaxWidth="1000" Margin="32" HorizontalAlignment="Center">
                <TextBlock Text="Подключение дисплея" FontSize="24" FontWeight="SemiBold" /><TextBlock Text="Работайте без платы через эмулятор или подключите дисплей по USB." Foreground="{StaticResource Muted}" Margin="0,9,0,24" FontSize="14" TextWrapping="Wrap" />
                <Border Background="White" CornerRadius="10" BorderBrush="{StaticResource Stroke}" BorderThickness="1" Padding="24"><StackPanel><TextBlock Text="Куда передавать изображение" FontSize="15" FontWeight="SemiBold" /><WrapPanel Margin="0,14,0,12"><ComboBox x:Name="Ports" Width="300" Margin="0,0,10,8" /><Button x:Name="RefreshPortsButton" Content="Обновить список" Click="RefreshPorts" Margin="0,0,10,8" /><Button x:Name="ConnectButton" Content="Подключить" Click="ToggleConnection" Style="{StaticResource PrimaryButton}" Margin="0,0,0,8" /></WrapPanel><TextBlock x:Name="ConnectionStatus" Text="Не подключено" Foreground="{StaticResource Muted}" TextWrapping="Wrap" /></StackPanel></Border>
                <Border Background="White" CornerRadius="10" BorderBrush="{StaticResource Stroke}" BorderThickness="1" Padding="24" Margin="0,18,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="280" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="ReceiverLabel" Text="Изображение на эмуляторе" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,16" /><Border Width="256" Height="256" CornerRadius="8" Background="#EEF2F8" Padding="8" HorizontalAlignment="Left"><Grid><TextBlock Text="Изображение появится&#x0a;после подключения" Foreground="{StaticResource Muted}" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center" /><Image x:Name="DevicePreview" Width="240" Height="240" RenderOptions.BitmapScalingMode="NearestNeighbor" /></Grid></Border></StackPanel><StackPanel Grid.Column="1" Margin="24,0,0,0"><TextBlock Text="Как проверить без устройства" FontWeight="SemiBold" FontSize="15" /><TextBlock Text="1. Выберите «Эмулятор (без платы)».&#x0a;2. Нажмите «Подключить».&#x0a;3. Откройте раздел «Показ» и проверьте смену страниц." TextWrapping="Wrap" Foreground="{StaticResource Muted}" LineHeight="24" Margin="0,12,0,22" /><Button Content="Открыть показ страниц →" Click="NavigateWorkspace" Tag="0" HorizontalAlignment="Left" /><TextBlock x:Name="Stats" Text="Статистика появится после подключения" Foreground="{StaticResource Muted}" TextWrapping="Wrap" FontSize="11" Margin="0,24,0,0" /></StackPanel></Grid></Border>
                <Expander Header="Диагностика соединения" Margin="0,22,0,0" Foreground="{StaticResource Muted}"><StackPanel Margin="0,14,0,0"><TextBlock Text="Эти действия проверяют восстановление передачи в эмуляторе." FontSize="12" Margin="0,0,0,12" TextWrapping="Wrap" /><WrapPanel><Button x:Name="CorruptButton" Content="Повредить пакет" Click="CorruptPacket" IsEnabled="False" Margin="0,0,10,8" /><Button x:Name="BreakButton" Content="Отключить на 3 с" Click="BreakConnection" IsEnabled="False" Margin="0,0,0,8" /></WrapPanel></StackPanel></Expander>
              </StackPanel></ScrollViewer>
            </Grid>
          <Grid x:Name="SourcesScreen" /><Grid x:Name="SettingsScreen" /></local:SectionHost>
        </Grid>
        <Border x:Name="InspectorPanel" Grid.Column="2" BorderBrush="{StaticResource Stroke}" BorderThickness="1,0,0,0" Background="White">
          <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <Border BorderBrush="{StaticResource Stroke}" BorderThickness="0,0,0,1" Padding="22,18"><TextBlock FontSize="16" FontWeight="SemiBold"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="Страница" /><Style.Triggers><DataTrigger Binding="{Binding SelectedIndex, ElementName=InspectorTabs}" Value="1"><Setter Property="Text" Value="Выбранный элемент" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Border>
            <Grid Grid.Row="1"><local:SectionHost x:Name="InspectorTabs" SelectedIndex="0">
            <Grid><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="22" TextElement.Foreground="{StaticResource Text}"><StackPanel>
              <TextBlock Text="Название" Foreground="{StaticResource Muted}" FontSize="12" /><TextBox x:Name="PageNameInput" MaxLength="60" TextChanged="PageSettingsChanged" LostKeyboardFocus="EndInputGroup" Margin="0,8,0,22" />
              <TextBlock Text="Время показа" Foreground="{StaticResource Muted}" FontSize="12" /><Grid Margin="0,8,0,18"><TextBox x:Name="DurationInput" Padding="12,9,38,9" Margin="0" TextChanged="PageSettingsChanged" LostKeyboardFocus="EndInputGroup" ToolTip="Длительность в секундах: от 1 до 3600" /><TextBlock Text="с" Foreground="{StaticResource Muted}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,34,0" IsHitTestVisible="False" /><StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0"><Button Style="{StaticResource StepperButton}" Content="⌃" Tag="DurationInput:1" Click="StepNumber" /><Button Style="{StaticResource StepperButton}" Content="⌄" Tag="DurationInput:-1" Click="StepNumber" /></StackPanel></Grid>
              <CheckBox x:Name="PageEnabled" Content="Участвует в показе" Checked="PageSettingsChanged" Unchecked="PageSettingsChanged" Margin="0,0,0,22" />
              <TextBlock Text="Цвет фона" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,0,0,9" /><local:ColorPicker x:Name="BackgroundPicker" ColorChanged="PageSettingsChanged" />
              <Separator Background="{StaticResource Stroke}" Margin="0,24,0,20" /><TextBlock Text="Размер холста" FontWeight="SemiBold" FontSize="12" /><TextBox Text="240 × 240" IsReadOnly="True" Background="#F1F5FA" BorderThickness="0" Foreground="#8A9AB3" Margin="0,10,0,22" />
              <Button Content="Показать эту страницу" Click="ShowSelectedPage"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Style.Triggers><DataTrigger Binding="{Binding SelectedIndex, ElementName=WorkspaceTabs}" Value="0"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></Button.Style></Button>
              <TextBlock Text="Переставляйте страницы в списке слева. На вкладке «Показ» можно проверить их смену." Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,18,0,0" />
            </StackPanel></ScrollViewer></Grid>
            <Grid><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="22" TextElement.Foreground="{StaticResource Text}"><StackPanel><TextBlock x:Name="EmptyLayerHint" Text="Выберите элемент на холсте или добавьте его слева." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Visibility="Collapsed" /><StackPanel x:Name="LayerProperties">
              <TextBlock x:Name="LayerTypeLabel" Foreground="{StaticResource Accent}" FontSize="11" Margin="0,0,0,16" /><TextBlock Text="Название элемента" Foreground="{StaticResource Muted}" FontSize="12" /><TextBox x:Name="LayerNameInput" MaxLength="60" TextChanged="LayerSettingsChanged" LostKeyboardFocus="EndInputGroup" />
              <StackPanel x:Name="LayerTextSection"><TextBlock Text="Текст" Foreground="{StaticResource Muted}" FontSize="12" /><TextBox x:Name="LayerTextInput" MaxLength="300" AcceptsReturn="True" Height="66" VerticalScrollBarVisibility="Auto" TextChanged="LayerSettingsChanged" LostKeyboardFocus="EndInputGroup" /></StackPanel>
              <Separator Background="{StaticResource Stroke}" Margin="0,10,0,18" /><TextBlock Text="Положение и размер" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,8" />
              <UniformGrid Columns="2"><StackPanel Margin="0,0,12,0"><TextBlock Text="X" Foreground="{StaticResource Muted}" FontSize="11" /><Grid><TextBox x:Name="XInput" Padding="10,7,25,7" TextChanged="LayerSettingsChanged" LostKeyboardFocus="EndInputGroup" /><StackPanel HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,3,0"><Button Style="{StaticResource StepperButton}" Content="⌃" Tag="XInput:1" Click="StepNumber" /><Button Style="{StaticResource StepperButton}" Content="⌄" Tag="XInput:-1" Click="StepNumber" /></StackPanel></Grid></StackPanel><StackPanel><TextBlock Text="Y" Foreground="{StaticResource Muted}" FontSize="11" /><Grid><TextBox x:Name="YInput" Padding="10,7,25,7" TextChanged="LayerSettingsChanged" LostKeyboardFocus="EndInputGroup" /><StackPanel HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,3,0"><Button Style="{StaticResource StepperButton}" Content="⌃" Tag="YInput:1" Click="StepNumber" /><Button Style="{StaticResource StepperButton}" Content="⌄" Tag="YInput:-1" Click="StepNumber" /></StackPanel></Grid></StackPanel></UniformGrid>
              <UniformGrid x:Name="ShapeProperties" Columns="2"><StackPanel Margin="0,0,12,0"><TextBlock Text="Ширина" Foreground="{StaticResource Muted}" FontSize="11" /><TextBox x:Name="WidthInput" TextChanged="LayerSettingsChanged" LostKeyboardFocus="EndInputGroup" /></StackPanel><StackPanel><TextBlock Text="Высота" Foreground="{StaticResource Muted}" FontSize="11" /><TextBox x:Name="HeightInput" TextChanged="LayerSettingsChanged" LostKeyboardFocus="EndInputGroup" /></StackPanel></UniformGrid>
              <StackPanel x:Name="ExtendedLayerProperties" /><StackPanel x:Name="TextProperties"><Separator Background="{StaticResource Stroke}" Margin="0,10,0,18" /><TextBlock Text="Типографика" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,12" /><TextBlock Text="Шрифт" Foreground="{StaticResource Muted}" FontSize="11" /><ComboBox x:Name="FontFamilyInput" SelectionChanged="LayerSettingsChanged" Margin="0,8,0,16" /><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="90" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Размер шрифта" Foreground="{StaticResource Muted}" FontSize="11" /><Grid><TextBox x:Name="FontInput" Padding="10,7,25,7" TextChanged="LayerSettingsChanged" LostKeyboardFocus="EndInputGroup" /><StackPanel HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,3,0"><Button Style="{StaticResource StepperButton}" Content="⌃" Tag="FontInput:1" Click="StepNumber" /><Button Style="{StaticResource StepperButton}" Content="⌄" Tag="FontInput:-1" Click="StepNumber" /></StackPanel></Grid></StackPanel><CheckBox x:Name="LayerBold" Grid.Column="1" Content="Жирный" Checked="LayerSettingsChanged" Unchecked="LayerSettingsChanged" VerticalAlignment="Center" Margin="12,8,0,0" /></Grid></StackPanel>
              <StackPanel x:Name="LayerColorSection"><TextBlock Text="Цвет текста / элемента" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,6,0,9" /><local:ColorPicker x:Name="LayerColorPicker" ColorChanged="LayerSettingsChanged" /></StackPanel><CheckBox x:Name="LayerVisible" Content="Показывать элемент" Checked="LayerSettingsChanged" Unchecked="LayerSettingsChanged" Margin="0,18,0,2" />
            </StackPanel></StackPanel></ScrollViewer></Grid>
          </local:SectionHost></Grid>
          </Grid>
        </Border>
      </Grid>
      <Grid Grid.Row="4" Background="White" Margin="16,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock x:Name="EditorStatus" Text="Выберите страницу, затем добавьте или выберите элемент" Foreground="{StaticResource Muted}" FontSize="10" VerticalAlignment="Center" /><TextBlock x:Name="LivePageLabel" Grid.Column="1" Foreground="{StaticResource Muted}" FontSize="10" Margin="12,0,20,0" VerticalAlignment="Center" /><TextBlock x:Name="ProjectStateLabel" Grid.Column="2" Text="Новый проект" Foreground="{StaticResource Muted}" FontSize="10" VerticalAlignment="Center" /></Grid>
      <ComboBox x:Name="LayerTemplate" Visibility="Collapsed" /><ComboBox x:Name="PageTemplate" SelectedIndex="3" Visibility="Collapsed"><ComboBoxItem Content="Часы" /><ComboBoxItem Content="Текст" /><ComboBoxItem Content="Тест цветов" /><ComboBoxItem Content="Пустая" /></ComboBox>
    </Grid>
  </Border>
</Window>
